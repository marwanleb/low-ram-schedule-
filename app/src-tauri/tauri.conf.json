{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marwan's Schedule",
  "version": "0.1.0",
  "identifier": "com.marwan.schedule",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Marwan's Schedule",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "visible": true,
        "skipTaskbar": false,
        "maximized": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}